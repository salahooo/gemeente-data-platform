# Environment variables and secrets
.env
secrets/*.txt
!secrets/*.txt.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ci-audit-requirements.txt
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Virtual environments
.venv/
venv/
env/

# Editor settings
.vscode/

# Generated data (keep directory placeholders tracked)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/runtime/*
!data/runtime/.gitkeep

# Logs
*.log
logs/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
