# Environment variables and secrets
.env
secrets/*.txt
!secrets/*.txt.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Editor settings
.vscode/

# Generated data (keep directory placeholders tracked)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs
*.log
logs/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
