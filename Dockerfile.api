FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
COPY pyproject.toml uv.lock README.md ./
RUN pip install --no-cache-dir "uv==0.9.28"
COPY src ./src
RUN uv sync --frozen --no-dev
USER app
EXPOSE 8000
# Render injects PORT at runtime. No migration or pipeline command runs here.
CMD ["/bin/sh", "-c", "exec /app/.venv/bin/uvicorn gemeente_data_platform.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
