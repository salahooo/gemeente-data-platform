# Gebruik automatische tekstherkenning als standaard.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Broncode, configuratie, documentatie en geserialiseerde tekst gebruiken LF.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.ipynb text eol=lf
.env text eol=lf
.env.* text eol=lf
*.example text eol=lf
*.svg text eol=lf

# Windows-scripts gebruiken CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaire bestanden niet als tekst behandelen.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.xlsx binary
*.xls binary
*.parquet binary
*.feather binary
*.pbix binary
