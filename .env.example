# Veilige voorbeeldwaarden voor lokale ontwikkeling.
# DATABASE_PASSWORD heeft alleen voor lokale probleemoplossing voorrang op
# DATABASE_PASSWORD_FILE; gebruik normaal het genegeerde secretbestand.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=gemeente_data
DATABASE_USER=gemeente_app
DATABASE_PASSWORD_FILE=secrets/app_password.txt
DATABASE_CONNECT_TIMEOUT=10
DATABASE_APPLICATION_NAME=gemeente-data-platform
DATABASE_SSLMODE=disable
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5434
TEST_DATABASE_NAME=gemeente_data_test
TEST_DATABASE_USER=gemeente_app
TEST_DATABASE_PASSWORD_FILE=secrets/app_password.txt
RUN_DB_INTEGRATION=0
CBS_BASE_URL=https://opendata.cbs.nl/ODataApi/OData
CBS_DATASET_CODE=03759ned
CBS_REQUEST_TIMEOUT=30
CBS_MAX_RETRIES=2
CBS_RETRY_BACKOFF_SECONDS=0.5
CBS_MAX_PAGES=100
